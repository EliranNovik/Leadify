# Apple Wallet / Google Wallet — business card passes
# Server-side only. Never expose certificates or private keys to the frontend.

# ─── Apple Wallet (.pkpass) ───────────────────────────────────────────────────
# 1. Apple Developer → Certificates, Identifiers & Profiles
# 2. Create a Pass Type ID (e.g. pass.com.deckerpexlevi.businesscard)
# 3. Create a Pass Type ID certificate, download the .cer, convert with Keychain/openssl
#    to PEM cert + key (see docs below).
# 4. Download Apple WWDR intermediate (G4) as PEM:
#    https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
#    openssl x509 -inform DER -in AppleWWDRCAG4.cer -out AppleWWDRCAG4.pem
#
APPLE_PASS_TYPE_ID=pass.com.yourcompany.businesscard
APPLE_TEAM_ID=YOUR10CHARTEAM
# Multiline PEMs: keep \n escaped in .env / Render
APPLE_PASS_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n
APPLE_PASS_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional if the key is encrypted
# APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n
# Or place the PEM at backend/certs/AppleWWDRCAG4.pem and omit APPLE_WWDR_CERT_PEM
# APPLE_WWDR_CERT_PATH=/absolute/path/to/AppleWWDRCAG4.pem

# Convert Pass certificate (.p12 from Keychain) example:
#   openssl pkcs12 -in Certificates.p12 -clcerts -nokeys -out pass_cert.pem
#   openssl pkcs12 -in Certificates.p12 -nocerts -nodes -out pass_key.pem

# ─── Google Wallet (Save link JWT) ────────────────────────────────────────────
# 1. Google Pay & Wallet Console → create Issuer, note Issuer ID
# 2. Google Cloud → create service account, download JSON key
# 3. In Wallet Console, grant that service account permission to manage passes
#
GOOGLE_WALLET_ISSUER_ID=3388000000000000000
GOOGLE_WALLET_CLASS_SUFFIX=business-card
# Prefer dedicated Wallet SA; falls back to GOOGLE_SERVICE_ACCOUNT_* if unset
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-passes@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Public frontend origin used inside QR / pass links
# APP_PUBLIC_URL=https://rainmakerqueen.org
# CRM_PUBLIC_URL=https://rainmakerqueen.org

# Endpoints (public, no auth — only exposes already-public business card data):
#   GET /api/wallet/status
#   GET /api/wallet/business-card/:employeeId/apple   → application/vnd.apple.pkpass
#   GET /api/wallet/business-card/:employeeId/google  → { saveUrl }
#   GET /api/wallet/business-card/:employeeId/google/redirect → 302 to Google
